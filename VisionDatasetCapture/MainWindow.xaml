<Window x:Class="VisionDatasetCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision Dataset Capture" Width="1600" Height="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Topmost="True"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
        </Grid.ColumnDefinitions>

        <Popup x:Name="FloatingMagnifierPopup" AllowsTransparency="True" Placement="Absolute" StaysOpen="True" IsHitTestVisible="False">
            <Border Width="96" Height="96" BorderBrush="Gold" BorderThickness="2" CornerRadius="4" Background="Black">
                <Image x:Name="FloatingMagnifierImage" Stretch="Fill"/>
            </Border>
        </Popup>

        <!-- Left side: Preview (Processed only, single image) -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Processed Frame (Full) with Zoom -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Background="Black" x:Name="PreviewBorder" ClipToBounds="True" MouseWheel="PreviewImage_MouseWheel" MouseMove="PreviewBorder_MouseMove" MouseLeftButtonDown="PreviewBorder_MouseLeftButtonDown" MouseDown="PreviewBorder_MouseDown" MouseUp="PreviewBorder_MouseUp">
                <Grid ClipToBounds="True">
                    <Image x:Name="ProcessedPreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomTransform" ScaleX="1.0" ScaleY="1.0"/>
                                <TranslateTransform x:Name="PanTransform" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Border>

            <!-- Zoom Info Bar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#F0F0F0" Margin="0,4,8,8">
                <TextBlock Text="Zoom: " VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" MinWidth="40"/>
                <Button x:Name="ZoomResetButton" Content="Reset" Height="24" Padding="8,2" Margin="8,0,0,0" Click="ZoomResetButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Right side: Settings -->
        <ScrollViewer Grid.Column="1" Margin="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Photoshop tools -->
                <TextBlock Text="PHOTOSHOP" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Crop option"/>
                <ComboBox x:Name="PhotoshopOperationComboBox" Margin="0,2,0,10"/>

                <Button x:Name="SelectPhotoshopPngFilesButton" Content="Select PNG Files" Height="30" Click="SelectPhotoshopPngFilesButton_Click" Margin="0,0,0,6"/>
                <TextBlock x:Name="PhotoshopSelectionSummaryTextBlock" Text="No PNG files selected" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Button x:Name="RunPhotoshopOperationButton" Content="Run" Height="30" Click="RunPhotoshopOperationButton_Click" Margin="0,0,0,6"/>
                <TextBlock x:Name="PhotoshopStatusTextBlock" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10" MinHeight="18"/>

                <Separator Margin="0,8"/>

                <!-- Capture Controls -->
                <TextBlock Text="CAPTURE SETTINGS" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Process / window"/>
                <ComboBox x:Name="ProcessComboBox" Margin="0,2,0,10" DropDownOpened="ProcessComboBox_DropDownOpened" SelectionChanged="ProcessComboBox_SelectionChanged"/>

                <Button x:Name="StartPreviewButton" Content="Start Capture" Height="34" Click="StartPreviewButton_Click" Margin="0,0,0,15" Background="CornflowerBlue" Foreground="White" FontWeight="Bold"/>

                <TextBlock Text="Dataset / class name"/>
                <TextBox x:Name="DatasetNameTextBox" Margin="0,2,0,10"/>

                <TextBlock Text="Capture mode"/>
                <ComboBox x:Name="CaptureModeComboBox" Margin="0,2,0,10" SelectionChanged="CaptureModeComboBox_SelectionChanged"/>

                <StackPanel x:Name="IntervalPanel">
                    <TextBlock Text="Interval (seconds)"/>
                    <TextBox x:Name="IntervalTextBox" Text="1" Margin="0,2,0,10"/>
                </StackPanel>

                <StackPanel x:Name="ManualKeyPanel">
                    <TextBlock Text="Manual capture key"/>
                    <TextBox x:Name="ManualKeyTextBox" Text="K" Margin="0,2,0,10"/>
                </StackPanel>

                <Button x:Name="ToggleButton" Content="Start Taking Screenshots" Height="34" Click="ToggleButton_Click" Margin="0,0,0,10"/>

                <TextBlock x:Name="ErrorMessageBlock" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,10" MinHeight="18"/>

                <!-- Status -->
                <Separator Margin="0,8"/>
                <TextBlock Text="STATUS" FontWeight="Bold" Margin="0,8,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="State:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StateLabel" Text="Stopped"/>
                    <TextBlock Grid.Row="1" Text="Mode:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ModeLabel" Text="-"/>
                    <TextBlock Grid.Row="2" Text="Process:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProcessLabel" Text="-" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="3" Text="Dataset:"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DatasetLabel" Text="-"/>
                    <TextBlock Grid.Row="4" Text="Captured:"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CapturedLabel" Text="0"/>
                    <TextBlock Grid.Row="5" Text="Last file:"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LastFileLabel" Text="-"/>

                    <!-- Process Window Info -->
                    <TextBlock Grid.Row="6" Text="PID:"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ProcessIdLabel" Text="-"/>
                    <TextBlock Grid.Row="7" Text="Window:"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="WindowDimensionsLabel" Text="-" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="8" Text="Pos:"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="WindowPositionLabel" Text="-" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="9" Text="Client:"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" x:Name="ClientDimensionsLabel" Text="-" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Post-Processing Settings -->
                <Separator Margin="0,16,0,8"/>
                <TextBlock Text="POST-PROCESSING" FontWeight="Bold" Margin="0,0,0,8"/>

                <CheckBox x:Name="PostProcessingEnabledCheckBox" Content="Enabled" Margin="0,0,0,10" Checked="PostProcessingSettings_Changed" Unchecked="PostProcessingSettings_Changed"/>

                <!-- Grayscale -->
                <CheckBox x:Name="GrayscaleCheckBox" Content="Grayscale" Margin="0,0,0,10" Checked="PostProcessingSettings_Changed" Unchecked="PostProcessingSettings_Changed"/>

                <!-- Brightness -->
                <TextBlock Text="Brightness"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="BrightnessSlider" Grid.Column="0" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.1" VerticalAlignment="Center" ValueChanged="PostProcessingSettings_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="BrightnessLabel" Text="0.0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Contrast -->
                <TextBlock Text="Contrast"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="ContrastSlider" Grid.Column="0" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" VerticalAlignment="Center" ValueChanged="PostProcessingSettings_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="ContrastLabel" Text="1.0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Saturation -->
                <TextBlock Text="Saturation"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SaturationSlider" Grid.Column="0" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1" VerticalAlignment="Center" ValueChanged="PostProcessingSettings_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="SaturationLabel" Text="1.0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Gamma -->
                <TextBlock Text="Gamma"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="GammaSlider" Grid.Column="0" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" VerticalAlignment="Center" ValueChanged="PostProcessingSettings_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="GammaLabel" Text="1.0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Crop Settings -->
                <Separator Margin="0,8,0,8"/>
                <CheckBox x:Name="CropEnabledCheckBox" Content="Crop" Margin="0,0,0,10" Checked="PostProcessingSettings_Changed" Unchecked="PostProcessingSettings_Changed"/>

                <StackPanel x:Name="CropSettingsPanel">
                    <TextBlock Text="Crop X"/>
                    <TextBox x:Name="CropXTextBox" Text="0" Margin="0,2,0,8" TextChanged="CropSettings_Changed"/>

                    <TextBlock Text="Crop Y"/>
                    <TextBox x:Name="CropYTextBox" Text="0" Margin="0,2,0,8" TextChanged="CropSettings_Changed"/>

                    <TextBlock Text="Crop Width"/>
                    <TextBox x:Name="CropWidthTextBox" Text="0" Margin="0,2,0,8" TextChanged="CropSettings_Changed"/>

                    <TextBlock Text="Crop Height"/>
                    <TextBox x:Name="CropHeightTextBox" Text="0" Margin="0,2,0,10" TextChanged="CropSettings_Changed"/>
                </StackPanel>

                <!-- Resize Settings -->
                <Separator Margin="0,8,0,8"/>
                <CheckBox x:Name="ResizeEnabledCheckBox" Content="Resize" Margin="0,0,0,10" Checked="PostProcessingSettings_Changed" Unchecked="PostProcessingSettings_Changed"/>

                <StackPanel x:Name="ResizeSettingsPanel">
                    <TextBlock Text="Resize Width"/>
                    <TextBox x:Name="ResizeWidthTextBox" Text="800" Margin="0,2,0,8" TextChanged="ResizeSettings_Changed"/>

                    <TextBlock Text="Resize Height"/>
                    <TextBox x:Name="ResizeHeightTextBox" Text="600" Margin="0,2,0,10" TextChanged="ResizeSettings_Changed"/>
                </StackPanel>

                <!-- Multi-color Effects (master/detail) -->
                <Separator Margin="0,16,0,8"/>
                <TextBlock Text="COLOR EFFECTS" FontWeight="Bold" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: rules list -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Rules" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ListBox x:Name="ColorEffectsRulesListBox" Height="210" SelectionChanged="ColorEffectsRulesListBox_SelectionChanged" Margin="0,0,0,6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Rectangle Width="14" Height="14" Stroke="Gray" StrokeThickness="1" Fill="{Binding SwatchBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ColorEffectsRulesEmptyStateText" Text="No color effects configured" Foreground="Gray" Margin="0,0,0,6" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddColorRuleButton" Content="Add Color" Height="30" Width="84" Click="AddColorRuleButton_Click" Margin="0,0,4,0"/>
                            <Button x:Name="RemoveColorRuleButton" Content="Remove" Height="30" Width="84" Click="RemoveColorRuleButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- RIGHT: existing detail controls for selected rule -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Selected Rule" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="ColorEffectRuleNameInput" Margin="0,0,0,8" Text="Color Effect 1" LostFocus="ColorEffectRuleNameInput_LostFocus" KeyDown="ColorEffectRuleNameInput_KeyDown"/>

                        <Button x:Name="EyedropperButton" Content="Start Eyedropper" Height="32" Click="EyedropperButton_Click" Background="SlateBlue" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="72" Height="72" BorderBrush="Gray" BorderThickness="1" Background="Black">
                                <Image x:Name="ColorMagnifierImage" Stretch="Fill"/>
                            </Border>
                            <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="Gray" BorderThickness="1" Background="White" Height="72">
                                <Rectangle x:Name="SelectedColorSwatch" Fill="Transparent"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="HEX:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ColorHexInput" Text="#FFFFFF" Margin="0,0,0,4" LostFocus="ColorHexInput_LostFocus" KeyDown="ColorInput_KeyDown"/>
                            <TextBlock Grid.Row="1" Text="RGBA:"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ColorRgbaInput" Text="255,255,255,255" Margin="0,0,0,4" LostFocus="ColorRgbaInput_LostFocus" KeyDown="ColorInput_KeyDown"/>
                            <TextBlock Grid.Row="2" Text="HSV:"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ColorHsvInput" Text="0,0,100" Margin="0,0,0,4" LostFocus="ColorHsvInput_LostFocus" KeyDown="ColorInput_KeyDown"/>
                            <TextBlock Grid.Row="3" Text="Coord:"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ColorCoordLabel" Text="-" TextDecorations="Underline" Cursor="Hand" ToolTip="Click to move mouse to this coordinate" MouseLeftButtonDown="ColorCoordLabel_MouseLeftButtonDown"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="EyedropperStateLabel" Text="Inactive" Foreground="Gray"/>
                        </Grid>

                        <CheckBox x:Name="ColorEffectsEnabledCheckBox" Content="Enable Color Effects" Margin="0,0,0,8" Checked="ColorEffectsSettings_Changed" Unchecked="ColorEffectsSettings_Changed"/>
                        <CheckBox x:Name="ColorEffectsMaskOverlayCheckBox" Content="Show Mask Overlay" Margin="0,0,0,6" Checked="ColorEffectsSettings_Changed" Unchecked="ColorEffectsSettings_Changed"/>
                        <CheckBox x:Name="ColorEffectsFreezeFrameCheckBox" Content="Freeze Frame" Margin="0,0,0,10" Checked="ColorEffectsSettings_Changed" Unchecked="ColorEffectsSettings_Changed"/>

                        <TextBlock Text="Hue tolerance (degrees)"/>
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ColorEffectsHueToleranceSlider" Grid.Column="0" Minimum="0" Maximum="180" Value="15" TickFrequency="1" ValueChanged="ColorEffectsSettings_Changed"/>
                            <TextBox x:Name="ColorEffectsHueToleranceInput" Grid.Column="1" Text="15" Margin="8,0,0,0" VerticalAlignment="Center" LostFocus="ColorEffectsNumericInput_LostFocus" KeyDown="ColorEffectsNumericInput_KeyDown"/>
                        </Grid>

                        <TextBlock Text="Saturation tolerance"/>
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ColorEffectsSaturationToleranceSlider" Grid.Column="0" Minimum="0" Maximum="1" Value="0.2" TickFrequency="0.01" ValueChanged="ColorEffectsSettings_Changed"/>
                            <TextBox x:Name="ColorEffectsSaturationToleranceInput" Grid.Column="1" Text="0.20" Margin="8,0,0,0" VerticalAlignment="Center" LostFocus="ColorEffectsNumericInput_LostFocus" KeyDown="ColorEffectsNumericInput_KeyDown"/>
                        </Grid>

                        <TextBlock Text="Value tolerance"/>
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ColorEffectsValueToleranceSlider" Grid.Column="0" Minimum="0" Maximum="1" Value="0.2" TickFrequency="0.01" ValueChanged="ColorEffectsSettings_Changed"/>
                            <TextBox x:Name="ColorEffectsValueToleranceInput" Grid.Column="1" Text="0.20" Margin="8,0,0,0" VerticalAlignment="Center" LostFocus="ColorEffectsNumericInput_LostFocus" KeyDown="ColorEffectsNumericInput_KeyDown"/>
                        </Grid>

                        <TextBlock Text="Effect"/>
                        <ComboBox x:Name="ColorEffectsModeComboBox" Margin="0,2,0,10" SelectionChanged="ColorEffectsSettings_Changed"/>

                        <TextBlock Text="Effect strength"/>
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ColorEffectsStrengthSlider" Grid.Column="0" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.01" ValueChanged="ColorEffectsSettings_Changed"/>
                            <TextBox x:Name="ColorEffectsStrengthInput" Grid.Column="1" Text="0.50" Margin="8,0,0,0" VerticalAlignment="Center" LostFocus="ColorEffectsNumericInput_LostFocus" KeyDown="ColorEffectsNumericInput_KeyDown"/>
                        </Grid>

                        <TextBlock Text="Target / custom color (HEX #RRGGBB)"/>
                        <TextBox x:Name="ColorEffectsTargetHexTextBox" Text="#FFFF00" Margin="0,2,0,10" TextChanged="ColorEffectsTargetHexTextBox_TextChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Settings Management -->
                <Separator Margin="0,16,0,8"/>
                <TextBlock Text="SETTINGS" FontWeight="Bold" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="ExportSettingsButton" Content="Export" Height="32" Click="ExportSettingsButton_Click" Padding="12,0" Margin="0,0,4,0" Background="DodgerBlue" Foreground="White" FontWeight="Bold"/>
                    <Button x:Name="ImportSettingsButton" Content="Import" Height="32" Click="ImportSettingsButton_Click" Padding="12,0" Margin="4,0,4,0" Background="DodgerBlue" Foreground="White" FontWeight="Bold"/>
                    <Button x:Name="ResetSettingsButton" Content="Reset to Default" Height="32" Click="ResetSettingsButton_Click" Padding="12,0" Margin="4,0,0,0" Background="Tomato" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock x:Name="SettingsMessageBlock" Foreground="DarkGreen" TextWrapping="Wrap" Margin="0,0,0,10" MinHeight="18"/>

                <TextBlock Text=""/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
