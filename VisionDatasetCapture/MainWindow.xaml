<Window x:Class="VisionDatasetCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision Dataset Capture" Width="460" Height="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <StackPanel Margin="16">
        <TextBlock Text="Process / window"/>
        <ComboBox x:Name="ProcessComboBox" Margin="0,2,0,10" DropDownOpened="ProcessComboBox_DropDownOpened"/>
        <TextBlock Text="Dataset / class name"/>
        <TextBox x:Name="DatasetNameTextBox" Margin="0,2,0,10"/>
        <TextBlock Text="Interval (seconds)"/>
        <TextBox x:Name="IntervalTextBox" Text="1" Margin="0,2,0,10"/>
        <Button x:Name="ToggleButton" Content="Start" Height="34" Click="ToggleButton_Click"/>
        <TextBlock x:Name="ErrorMessageBlock" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="18"/>
        <Separator Margin="0,8"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="State:"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StateLabel" Text="Stopped"/>
            <TextBlock Grid.Row="1" Text="Process:"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProcessLabel" Text="-" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="2" Text="Dataset:"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DatasetLabel" Text="-"/>
            <TextBlock Grid.Row="3" Text="Captured:"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CapturedLabel" Text="0"/>
            <TextBlock Grid.Row="4" Text="Last file:"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LastFileLabel" Text="-"/>
        </Grid>
    </StackPanel>
</Window>
