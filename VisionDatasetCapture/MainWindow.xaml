<Window x:Class="VisionDatasetCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision Dataset Capture" Width="1000" Height="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
        </Grid.ColumnDefinitions>

        <!-- Left side: Preview (Processed only, single image) -->
        <Grid Grid.Column="0" Margin="8">
            <!-- Processed Frame (Full) -->
            <Border BorderBrush="Gray" BorderThickness="1" Background="Black">
                <Image x:Name="ProcessedPreviewImage" Stretch="Uniform"/>
            </Border>
        </Grid>

        <!-- Right side: Settings -->
        <ScrollViewer Grid.Column="1" Margin="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Capture Controls -->
                <TextBlock Text="CAPTURE SETTINGS" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Process / window"/>
                <ComboBox x:Name="ProcessComboBox" Margin="0,2,0,10" DropDownOpened="ProcessComboBox_DropDownOpened" SelectionChanged="ProcessComboBox_SelectionChanged"/>

                <Button x:Name="StartPreviewButton" Content="Start Capture" Height="34" Click="StartPreviewButton_Click" Margin="0,0,0,15" Background="CornflowerBlue" Foreground="White" FontWeight="Bold"/>

                <TextBlock Text="Dataset / class name"/>
                <TextBox x:Name="DatasetNameTextBox" Margin="0,2,0,10"/>

                <TextBlock Text="Capture mode"/>
                <ComboBox x:Name="CaptureModeComboBox" Margin="0,2,0,10" SelectionChanged="CaptureModeComboBox_SelectionChanged"/>

                <StackPanel x:Name="IntervalPanel">
                    <TextBlock Text="Interval (seconds)"/>
                    <TextBox x:Name="IntervalTextBox" Text="1" Margin="0,2,0,10"/>
                </StackPanel>

                <StackPanel x:Name="ManualKeyPanel">
                    <TextBlock Text="Manual capture key"/>
                    <TextBox x:Name="ManualKeyTextBox" Text="K" Margin="0,2,0,10"/>
                </StackPanel>

                <Button x:Name="ToggleButton" Content="Start Taking Screenshots" Height="34" Click="ToggleButton_Click" Margin="0,0,0,10"/>

                <TextBlock x:Name="ErrorMessageBlock" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,10" MinHeight="18"/>

                <!-- Status -->
                <Separator Margin="0,8"/>
                <TextBlock Text="STATUS" FontWeight="Bold" Margin="0,8,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="State:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StateLabel" Text="Stopped"/>
                    <TextBlock Grid.Row="1" Text="Mode:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ModeLabel" Text="-"/>
                    <TextBlock Grid.Row="2" Text="Process:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProcessLabel" Text="-" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="3" Text="Dataset:"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DatasetLabel" Text="-"/>
                    <TextBlock Grid.Row="4" Text="Captured:"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CapturedLabel" Text="0"/>
                    <TextBlock Grid.Row="5" Text="Last file:"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LastFileLabel" Text="-"/>
                </Grid>

                <!-- Post-Processing Settings -->
                <Separator Margin="0,16,0,8"/>
                <TextBlock Text="POST-PROCESSING" FontWeight="Bold" Margin="0,0,0,8"/>

                <CheckBox x:Name="PostProcessingEnabledCheckBox" Content="Enabled" Margin="0,0,0,10" Checked="PostProcessingSettings_Changed" Unchecked="PostProcessingSettings_Changed"/>

                <!-- Grayscale -->
                <CheckBox x:Name="GrayscaleCheckBox" Content="Grayscale" Margin="0,0,0,10" Checked="PostProcessingSettings_Changed" Unchecked="PostProcessingSettings_Changed"/>

                <!-- Brightness -->
                <TextBlock Text="Brightness"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="BrightnessSlider" Grid.Column="0" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.1" VerticalAlignment="Center" ValueChanged="PostProcessingSettings_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="BrightnessLabel" Text="0.0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Contrast -->
                <TextBlock Text="Contrast"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="ContrastSlider" Grid.Column="0" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" VerticalAlignment="Center" ValueChanged="PostProcessingSettings_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="ContrastLabel" Text="1.0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Saturation -->
                <TextBlock Text="Saturation"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SaturationSlider" Grid.Column="0" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1" VerticalAlignment="Center" ValueChanged="PostProcessingSettings_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="SaturationLabel" Text="1.0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Gamma -->
                <TextBlock Text="Gamma"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="GammaSlider" Grid.Column="0" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" VerticalAlignment="Center" ValueChanged="PostProcessingSettings_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="GammaLabel" Text="1.0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Crop Settings -->
                <Separator Margin="0,8,0,8"/>
                <CheckBox x:Name="CropEnabledCheckBox" Content="Crop" Margin="0,0,0,10" Checked="PostProcessingSettings_Changed" Unchecked="PostProcessingSettings_Changed"/>

                <StackPanel x:Name="CropSettingsPanel">
                    <TextBlock Text="Crop X"/>
                    <TextBox x:Name="CropXTextBox" Text="0" Margin="0,2,0,8" TextChanged="CropSettings_Changed"/>

                    <TextBlock Text="Crop Y"/>
                    <TextBox x:Name="CropYTextBox" Text="0" Margin="0,2,0,8" TextChanged="CropSettings_Changed"/>

                    <TextBlock Text="Crop Width"/>
                    <TextBox x:Name="CropWidthTextBox" Text="0" Margin="0,2,0,8" TextChanged="CropSettings_Changed"/>

                    <TextBlock Text="Crop Height"/>
                    <TextBox x:Name="CropHeightTextBox" Text="0" Margin="0,2,0,10" TextChanged="CropSettings_Changed"/>
                </StackPanel>

                <!-- Resize Settings -->
                <Separator Margin="0,8,0,8"/>
                <CheckBox x:Name="ResizeEnabledCheckBox" Content="Resize" Margin="0,0,0,10" Checked="PostProcessingSettings_Changed" Unchecked="PostProcessingSettings_Changed"/>

                <StackPanel x:Name="ResizeSettingsPanel">
                    <TextBlock Text="Resize Width"/>
                    <TextBox x:Name="ResizeWidthTextBox" Text="800" Margin="0,2,0,8" TextChanged="ResizeSettings_Changed"/>

                    <TextBlock Text="Resize Height"/>
                    <TextBox x:Name="ResizeHeightTextBox" Text="600" Margin="0,2,0,10" TextChanged="ResizeSettings_Changed"/>
                </StackPanel>

                <TextBlock Text=""/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
